# Backend only. Never prefix this secret with VITE_ or copy it into client files.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# Optional network configuration for LAN access:
HOST=127.0.0.1
PORT=2567

# Production: serve the built client from this directory (relative to server).
# CLIENT_DIRECTORY=../client/dist
# PUBLIC_ORIGIN=https://your-game.example.com
# ALLOWED_ORIGINS=https://your-game.example.com
# Durable match-result retry queue; mount persistent storage here in production.
# RESULTS_DIRECTORY=/data/results
