# Optional: override the multiplayer server URL. Development defaults to port 2567.
# Production defaults to the page's own origin (one combined game service).
# Use an HTTPS/WSS server when hosting the frontend over HTTPS.
# VITE_MULTIPLAYER_URL=http://localhost:2567

# Optional Supabase cloud accounts. Only use the PUBLIC publishable key here.
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
