# Optional: override the multiplayer server URL. Defaults to the current hostname, port 2567.
# Use an HTTPS/WSS server when hosting the frontend over HTTPS.
# VITE_MULTIPLAYER_URL=http://localhost:2567

# Optional Supabase cloud accounts. Only use the PUBLIC publishable key here.
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
